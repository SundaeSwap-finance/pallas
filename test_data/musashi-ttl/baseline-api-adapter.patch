+// Baseline API adapters: only adapt the supplied linear capture time mapping.
+// The unchanged native evaluator still rejects the finite upper bound.
+#[cfg(feature = "unstable")]
+fn baseline_slots(time: &crate::utils::DijkstraTimeContext) -> SlotConfig {
+    let slot = time.validation_slot();
+    let now = time.slot_to_posix_ms(slot).unwrap();
+    SlotConfig { zero_slot: slot, zero_time: now, slot_length: time.slot_to_posix_ms(slot + 1).unwrap() - now }
+}
+#[cfg(feature = "unstable")]
+pub fn evaluate_tx_with_time(tx: &MultiEraTx, pp: &MultiEraProtocolParameters, utxos: &UtxoMap, time: &crate::utils::DijkstraTimeContext) -> Result<EvalReport, Error> {
+    evaluate_tx(tx, pp, utxos, &baseline_slots(time))
+}
+#[cfg(feature = "unstable")]
+pub fn estimate_tx_with_time(tx: &MultiEraTx, pp: &MultiEraProtocolParameters, utxos: &UtxoMap, time: &crate::utils::DijkstraTimeContext) -> Result<EvalReport, Error> {
+    estimate_tx(tx, pp, utxos, &baseline_slots(time))
+}
