+    };
+    let raw = read("1401365.block");
+    let raw_producer = read("1401345.block");
+    let block = MultiEraBlock::decode(&raw).unwrap();
+    let producer = MultiEraBlock::decode(&raw_producer).unwrap();
+    let txs = block.txs();
+    let producers = producer.txs();
