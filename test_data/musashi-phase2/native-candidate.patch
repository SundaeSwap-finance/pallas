+        // eval_redeemer propagates protocol version; NOT native evidence.
+        let body = minicbor::to_vec(&tx.transaction_body).unwrap();
+        let witnesses = minicbor::to_vec(&tx.transaction_witness_set).unwrap();
+        let conway = c::Tx {
+            transaction_body: minicbor::decode(&body).unwrap(),
+            transaction_witness_set: minicbor::decode(&witnesses).unwrap(),
+            success: true,
+            auxiliary_data: pallas_codec::utils::Nullable::Null,
+        };
+        let inputs: Vec<_> = u
+            .iter()
+            .map(|(i, raw)| ResolvedInput {
+                input: n::TransactionInput {
+                    transaction_id: i.0,
+                    index: u64::from(i.1),
+                },
+                output: minicbor::decode(&raw.1).unwrap(),
+            })
+            .collect();
+        let view = MultiEraTx::from_conway(&conway);
+        let lookup = DataLookupTable::from_transaction(&view, &inputs);
+        let redeemers = view.redeemers();
+        let redeemer: &MultiEraRedeemer = &redeemers[0];
+        for version in [9, 10, 12] {
